{
  "name": "seng383-g4-server",
  "version": "0.0.0",
  "private": true,
  "description": "Express and SQLite walking skeleton",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "node src/seed.js",
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60
      }
    }
  }
}
