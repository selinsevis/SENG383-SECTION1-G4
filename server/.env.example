# Copy this file to server/.env and fill in the values. server/.env is not pushed to GitHub.

# Secret used to sign login tokens (JWT). Use any long random text.
JWT_SECRET=

# Path of the SQLite file. Leave empty to use server/data/development.sqlite.
DB_PATH=

# Deterministic offline provider; real AI integration is a separate M8 follow-up.
AI_MODE=mock
